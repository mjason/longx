#!/bin/sh
# Sourced by bin/longx before the VM starts (mix release's rel/env.sh.eex).

# File names are UTF-8 whatever the locale of the shell that started us:
# without this a bare environment (systemd, a container) runs the VM in
# latin1 mode and Elixir warns; project paths with CJK would suffer.
export ELIXIR_ERL_OPTIONS="+fnu ${ELIXIR_ERL_OPTIONS}"
