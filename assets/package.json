{
  "name": "longx",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p extension --noEmit",
    "test": "vitest run",
    "test:scroll": "node scripts/test-chat-scroll.mjs",
    "test:clipboard": "node scripts/test-clipboard.mjs",
    "test:projects": "node scripts/test-project-switch.mjs",
    "test:chat-projects": "node scripts/test-chat-projects.mjs",
    "test:queued-attachments": "node scripts/test-queued-attachments.mjs",
    "test:command-guards": "node scripts/test-command-guards.mjs",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "present-schema": "node scripts/present-schema.mjs",
    "check:prompts": "node scripts/check-prompt-changes.mjs",
    "codegen": "node scripts/gql-client.mjs && graphql-codegen --config codegen.ts",
    "codegen:check": "npm run codegen && git diff --exit-code --quiet -- js/gql js/core/api.ts js/core/operations.graphql",
    "e2e": "node scripts/e2e/run.mjs",
    "build:extension": "vite build --config extension/vite.config.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.19",
    "@assistant-ui/react-generative-ui": "^0.0.18",
    "@assistant-ui/react-markdown": "^0.14.15",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-query": "^5.90.0",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "codemirror-lang-elixir": "^4.0.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "katex": "^0.16.47",
    "lucide-react": "^0.545.0",
    "phoenix": "file:../deps/phoenix",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.15",
    "react-router": "^7.9.3",
    "react-shiki": "^0.11.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-shimmer": "^0.4.13",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^24.6.0",
    "@types/phoenix": "^1.6.7",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "0.28.2",
    "graphql": "^16.14.2",
    "jsdom": "^27.0.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
