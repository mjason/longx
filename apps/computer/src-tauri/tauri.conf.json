{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Longx Computer",
  "version": "0.2.113",
  "identifier": "com.longx.computer",
  "build": { "frontendDist": "../ui" },
  "plugins": {
    "updater": { "pubkey": "" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Longx Computer", "width": 640, "height": 780, "minWidth": 460, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "resources/driver/": "driver/" },
    "macOS": { "minimumSystemVersion": "13.0" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
